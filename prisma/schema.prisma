generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Destinasi {
  id        Int      @id @default(autoincrement())
  nama      String
  deskripsi String
  lokasi    String?
  kategori  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
